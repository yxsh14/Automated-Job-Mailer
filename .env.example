# ========================================
# Email Automation Service Configuration
# ========================================

# ── Email / SMTP ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-16-digit-app-password

# ── File Paths (local mode only) ─────────
EXCEL_FILE=data/contacts.xlsx
RESUME_FILE=data/resume.pdf
TEMPLATE_FILE=templates/email_template.txt

# ── Google Sheets (cloud mode) ───────────
# Leave blank to use local Excel instead.
# Set both to switch to Google Sheets backend.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_JSON=

# ── Schedule ─────────────────────────────
START_HOUR=9
END_HOUR=16
EMAILS_PER_DAY=20
MIN_INTERVAL_MINUTES=18
MAX_INTERVAL_MINUTES=24

# ── Logging ──────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Safety ───────────────────────────────
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60
