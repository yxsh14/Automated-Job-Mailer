# ========================================
# Email Automation Service Configuration
# ========================================

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-16-digit-app-password

# File Paths
EXCEL_FILE=data/contacts.xlsx
RESUME_FILE=data/resume.pdf
TEMPLATE_FILE=templates/email_template.txt

# Schedule Configuration
START_HOUR=9
END_HOUR=16
EMAILS_PER_DAY=20
MIN_INTERVAL_MINUTES=18
MAX_INTERVAL_MINUTES=24

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Safety Limits
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60
